<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>
    <h1>Gestions des utilisateurs</h1>

    {{ name }}

    <table border="1" cellpadding="5" cellspacing="0">
        {% for user in users %}
            <tr>
                <td>
                    {% if user == Teacher %}
                        Professeur : 
                    {% elseif user == Student %}
                        Élève :
                    {% else %}
                        Autre : 
                </td>
                    {% endif %}
                        <td>{{ user.name|title }}</td>
            </tr>
        {% endfor %}
    </table>
</body>
</html>