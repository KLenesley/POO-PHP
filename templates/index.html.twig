<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>
    <h1>Gestions des utilisateurs</h1>

    {{ name }}

    <ul>
    {% for user in users %}
        {% if user.matieres == "SLAM" %}
            <span style="color: red;">
        {% else %}
            <span style="color: green;">
        {% endif %}
                <li>{{ user.name|title }} </li>
        </span>
    {% endfor %}
    </ul>
</body>
</html>